<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlbumList.MainPage"
             xmlns:local="clr-namespace:AlbumList"
             x:DataType="local:AlbumViewModel"
             Title="Album List">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="10">

        <Entry Grid.Row="0"
               Text="{Binding LibraryName}"
               FontSize="Large"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="10"
                               HorizontalOptions="Center">
            <Button Text="Title"
                    Command="{Binding SortCommand}"
                    CommandParameter="Title" />
            <Button Text="Artist"
                    Command="{Binding SortCommand}"
                    CommandParameter="Artist" />
            <Button Text="Year"
                    Command="{Binding SortCommand}"
                    CommandParameter="Year" />
            <Button Text="Add Album" Clicked="AddAlbumButton_Clicked" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="2" Spacing="4">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}" />
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Albums}"
                        SelectionMode="Single"
                        SelectionChanged="CollectionView_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Album">
                    <Grid Padding="10"
                          VerticalOptions="Center"
                          ColumnDefinitions="*,55">
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding Title}" FontSize="Medium" FontAttributes="Bold" />
                            <Label Text="{Binding Artist}" FontSize="Small" />
                            <Label Text="{Binding Year}" FontSize="Small" />
                            <Label Text="{Binding Genre}" FontSize="Small" />
                        </VerticalStackLayout>
                        <Button Text="Edit"
                                Grid.Column="1"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Margin="20,0,0,0"
                                WidthRequest="55"
                                HeightRequest="50"
                                Clicked="EditButton_Clicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
 