<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Week8Demo.MainPage"
             Title="MVVM Example"
             xmlns:viewmodels="clr-namespace:Week8Demo"
             x:DataType="viewmodels:MyViewModel">

    <VerticalStackLayout Padding="25" Spacing="20">

        <Label Text="MVVM Example"
           FontSize="Large"
           FontAttributes="Bold"
           HorizontalOptions="Center" />

        <!-- Text Binding -->
        <VerticalStackLayout Spacing="8">
            <Label Text="Text Binding"
               FontSize="Medium"
               FontAttributes="Bold"/>

            <Entry Text="{Binding MyText}"
               Placeholder="Enter some text"/>

            <Label Text="{Binding MyText}"
               FontSize="Medium"
               HorizontalOptions="Center"/>

            <Button Text="Change Text"
                Command="{Binding ChangeTextCommand}"/>
        </VerticalStackLayout>

        <BoxView HeightRequest="1"
             Color="LightGray"/>

        <!-- Timer -->
        <VerticalStackLayout Spacing="8">
            <Label Text="Timer"
               FontSize="Medium"
               FontAttributes="Bold"/>

            <Label Text="{Binding TimeLeft}"
               FontSize="Large"
               HorizontalOptions="Center"/>

            <ActivityIndicator IsVisible="{Binding IsRunning}"
                           IsRunning="{Binding IsRunning}"
                           HorizontalOptions="Center"/>

            <Button Text="{Binding StartStop}"
                Command="{Binding StartTimer}"/>
        </VerticalStackLayout>

        <BoxView HeightRequest="1"
             Color="LightGray"/>

        <!-- Score -->
        <VerticalStackLayout Spacing="8">
            <Label Text="Score"
               FontSize="Medium"
               FontAttributes="Bold"/>

            <Label Text="{Binding Score}"
               FontSize="Large"
               HorizontalOptions="Center"/>

            <HorizontalStackLayout Spacing="15"
                               HorizontalOptions="Center">
                <Button Text="-1"
                    Command="{Binding ChangeScoreCommand}"
                    CommandParameter="-1"
                    WidthRequest="80"/>

                <Button Text="+1"
                    Command="{Binding ChangeScoreCommand}"
                    CommandParameter="1"
                    WidthRequest="80"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>
