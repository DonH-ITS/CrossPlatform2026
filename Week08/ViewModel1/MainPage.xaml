<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Week8Demo.MainPage"
             Title="MVVM Example"
             xmlns:viewmodels="clr-namespace:Week8Demo"
             x:DataType="viewmodels:MyViewModel">

    <VerticalStackLayout Padding="30"
                         Spacing="20">


        <Label Text="MVVM Example"
               FontSize="Large"
               HorizontalOptions="Center" />

        <VerticalStackLayout Padding="20" Spacing="10">
            <Entry Text="{Binding MyText}" />
            <Label Text="{Binding MyText}" />
            <Button Text="Change Text" Command="{Binding ChangeTextCommand}" />
        </VerticalStackLayout>
        
        <Label Text="{Binding TimeLeft}" />

        <Button Text="+1" Command="{Binding ChangeScoreCommand}" CommandParameter="1" />
        <Button Text="-1" Command="{Binding ChangeScoreCommand}" CommandParameter="-1" />
        
        <Label Text="{Binding Score}" />


    </VerticalStackLayout>

</ContentPage>
