<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Week9Demo.MainPage">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙ Settings" Clicked="Settings_Clicked" />
    </ContentPage.ToolbarItems>-->

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="{AppThemeBinding Light=settings.png, Dark=settingsdark.png}" Clicked="Settings_Clicked" Text="Settings"/>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label x:Name="MessageLabel" Text="Choose a planet" TextColor="Black" />
        <Label x:Name="SoundLabel" TextColor="Black" />

        <Button Text="Mercury" Clicked="Planet_Clicked" />
        <Button Text="Venus" Clicked="Planet_Clicked" />
        <Button Text="Earth" Clicked="Planet_Clicked" />
        <Button Text="Mars" Clicked="Planet_Clicked" />

    </VerticalStackLayout>

</ContentPage>
